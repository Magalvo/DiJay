# Discord application
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id
# Private server allowlist. Commands are only registered and accepted here.
DISCORD_GUILD_ID=replace-with-your-private-server-id

# Lavalink node
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace-with-a-long-random-password
LAVALINK_SECURE=false

# Spotify (LavaSrc). Consumed by the Lavalink container, not the bot. Metadata only:
# audio is mirrored through YouTube. A free Spotify account is enough. Leave the
# credentials empty to disable Spotify links without affecting other sources.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=PT

# Runtime
BOT_STATUS_TEXT=música | /play
LOG_LEVEL=info
NODE_ENV=development
DATA_DIR=./data
HEALTH_PORT=3000
IDLE_TIMEOUT_SECONDS=300
DEFAULT_VOLUME=80

# Voice recognition (experimental, opt-in). Requires the optional deps
# (npm install --include=optional) and a downloaded Vosk model. The lean
# production image does not ship these, so keep it disabled there.
VOICE_ENABLED=false
# Path to the downloaded Vosk model directory. Used by the in-process voice feature AND the
# listener sidecar. A relative path works both locally and in Docker (it resolves under the
# container's /app via the ./models mount). Examples:
#   pt -> ./models/vosk-model-small-pt-0.3
#   en -> ./models/vosk-model-small-en-us-0.15
VOICE_STT_MODEL_PATH=./models/vosk-model-small-pt-0.3
# Spoken-command language: pt or en. The Vosk model at VOICE_STT_MODEL_PATH must match.
VOICE_LANGUAGE=pt

# Voice-listener sidecar (WI-013, optional). A SECOND Discord application dedicated to
# receiving voice; it forwards recognized commands to the main bot over the private network
# so playback via Lavalink is never interrupted. Leave VOICE_IPC_SECRET empty to keep both
# the sidecar and the main bot's internal endpoint disabled. The secret must be >= 16 chars.
VOICE_BOT_TOKEN=
VOICE_BOT_CLIENT_ID=
VOICE_IPC_SECRET=
VOICE_IPC_PORT=3100
VOICE_IPC_URL=http://bot:3100
# Hands-free listening (WI-014): the listener stays in the voice channel and acts on any
# utterance beginning with the wake word "dj". Opt-in; false keeps the push-to-talk /listen.
VOICE_WAKE_WORD_ENABLED=false
# Soundboard triggers (WI-015): self-triggering words that play a native Discord soundboard
# sound over the music, no "dj" prefix needed. Comma-separated key:soundId pairs; the key must
# be a recognized trigger (currently "gelado", "leite"). Requires VOICE_WAKE_WORD_ENABLED=true
# and the listener bot to have the UseSoundboard permission. Get the sound id from the server's
# soundboard (Discord: right-click the sound, or via the API). Empty disables the feature.
VOICE_SOUNDBOARD_SOUNDS=gelado:1530713477050667118,leite:1530716272285716531
