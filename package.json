{
  "name": "dijay",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible Discord music bot built with SDD and TDD.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:voice": "tsc -p tsconfig.voice-build.json",
    "db:backup": "node dist/infrastructure/sqlite/backup-database.js",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "register:commands": "tsx src/presentation/discord/register-commands.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:voice": "tsc --noEmit -p tsconfig.voice.json"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "poru": "5.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@discordjs/voice": "0.19.2",
    "libsodium-wrappers": "0.8.4",
    "opusscript": "0.0.8",
    "prism-media": "1.3.5",
    "vosk-koffi": "1.1.1"
  }
}
